# Arc Mainnet is the production default.
ARC_NETWORK=mainnet
PORT=3000

# Mainnet uses the existing Uniswap V3 pool; no contract deployment is required.
# Testnet only: public address of a deployed and funded ArcFXRemittance contract.
# This is not a secret and can be committed or configured in Vercel.
ARC_REMITTANCE_ADDRESS=

# Comma-separated browser origins allowed to call the API in production.
# Same-origin requests are always accepted.
ALLOWED_ORIGINS=
