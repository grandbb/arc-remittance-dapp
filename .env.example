# Arc Mainnet is the production default. Use testnet together with Circle sandbox.
ARC_NETWORK=mainnet
PORT=3000

# StableFX credentials are issued to vetted institutions by Circle.
# Never expose this key in browser code or commit a real value.
CIRCLE_API_KEY=
CIRCLE_API_BASE_URL=https://api.circle.com

# Comma-separated browser origins allowed to call the API in production.
# Same-origin requests are always accepted.
ALLOWED_ORIGINS=
